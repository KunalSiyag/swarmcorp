{
  "name": "swarmcorp",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first mission control for coding agents (Claude Code, Codex, Gemini CLI, Antigravity and opencode): live map, timeline, context meters, terminals and run receipts.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/server.ts",
    "fleet": "vite build && tsx server/server.ts --fleet",
    "simulate": "tsx scripts/simulate.ts",
    "install-claude": "tsx scripts/install-claude.ts",
    "typecheck": "tsc --noEmit",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts && node scripts/site-routes.mjs",
    "preview:site": "vite preview --config vite.site.config.ts --port 4173",
    "prepack": "npm run build",
    "doctor": "node bin/swarmcorp.mjs doctor"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "swarmcorp": "bin/swarmcorp.mjs"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "claude-home",
    "scripts",
    "dist",
    "swarmcorp.config.json",
    "README.md",
    "docs",
    "LICENSE.md"
  ],
  "keywords": [
    "agents",
    "antigravity",
    "claude-code",
    "codex",
    "dashboard",
    "gemini-cli",
    "hooks",
    "multi-agent",
    "observability",
    "opencode"
  ],
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/KunalSiyag/swarmcorp.git"
  },
  "homepage": "https://github.com/KunalSiyag/swarmcorp"
}
